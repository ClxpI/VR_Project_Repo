# Unity .gitignore
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Aa]ssetstore[Dd]ata/

# Memory dumps
*.pdb
*.vmp

# Autogenerated VS/VSCode project files
*.csproj
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crashlytics generated file
crashlytics-build.properties

# OS generated files
.DS_Store
Thumbs.db
