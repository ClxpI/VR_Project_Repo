    - target: {fileID: 7315846840873614183, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_text
      value: 'Teacher (You):

        Absolutely. Germany is one of the largest and
        most influential EU members.'
      objectReference: {fileID: 0}
    - target: {fileID: 7371842396866607334, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_Name
      value: Dialogue Panel
      objectReference: {fileID: 0}
    - target: {fileID: 7914161221112404875, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_text
      value: "Student 1 (Alex):\nUmm\u2026 France?"
      objectReference: {fileID: 0}
    - target: {fileID: 8252035408603660454, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8252035408603660454, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchorMin.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8252035408603660454, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 79
      objectReference: {fileID: 0}
    - target: {fileID: 8252035408603660454, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -4
      objectReference: {fileID: 0}
    - target: {fileID: 8434296906904588645, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_text
      value: 'Teacher (You):

        Good guess but no, Norway is part of Europe,
        but not the EU.'
      objectReference: {fileID: 0}
    - target: {fileID: 8453249017670578551, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8453249017670578551, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8453249017670578551, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8453249017670578551, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8734957425447910999, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_text
      value: 'Student 2 (Mia):

        Is Norway in the EU?'
      objectReference: {fileID: 0}
    - target: {fileID: 8773140015345055572, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_text
      value: 'Teacher (You):

        Correct! France is one of the founding members.
        What about you, Mia?'
      objectReference: {fileID: 0}
    - target: {fileID: 9214743176202133696, guid: b4b3df1701e66c547944234224e91693, type: 3}
      propertyPath: m_IsActive
      value: 0
