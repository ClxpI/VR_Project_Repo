<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.oramavr.mages.core/JARIA/Editor/JARIAUSS.uss?fileID=7433441132597879392&amp;guid=01402a26e35537043b76149570749b91&amp;type=3#JARIAUSS" />
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(30, 30, 30); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
        <ui:Label tabindex="-1" text="Storyboard Generator" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-font-style: bold; font-size: 16px; color: rgb(255, 255, 255); margin-left: 15px; justify-content: flex-start; align-items: auto; height: auto; width: auto;" />
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: center; justify-content: flex-start; margin-left: 13px; margin-top: 10px; margin-bottom: 10px;">
            <ui:Button text="Clear History" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ClearHistoryButton" tooltip="Clear the history of the agent to resolve any crashes or bad responses." style="flex-direction: row; max-width: 150px; margin-top: 0; margin-bottom: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="Content" style="flex-grow: 1; background-color: rgb(60, 60, 60); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 15px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
            <ui:ScrollView name="ChatScroll" style="margin-bottom: 20px; align-items: stretch; justify-content: flex-start; align-self: auto; height: auto;">
                <ui:Label tabindex="-1" text="How to use:&#10;Insert a textual description of a medical operation. The JARIA agent will automatically brake it down into simple, individual steps (Actions) and generate a diagram with the storyboard.&#10;The agent will provide a link to download the storyboard in a pdf form." parse-escape-sequences="true" display-tooltip-when-elided="true" name="InfoLabel" style="background-color: rgb(9, 166, 103); color: rgb(255, 255, 255); margin-top: 30px; margin-right: 10px; margin-left: 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; white-space: normal;" />
                <ui:GroupBox name="JARIARes" style="padding-left: 5px; margin-left: 0;">
                    <ui:GroupBox name="InitGroupLabels" class="jarialabelbox">
                        <ui:VisualElement name="BotPhoto" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.oramavr.mages.core/JARIA/Editor/PanelImages/BotImage.png?fileID=2800000&amp;guid=9405c390693d63243b7f8face650fb2e&amp;type=3#BotImage&quot;);" />
                        <ui:Label tabindex="-1" text="JARIA" parse-escape-sequences="true" display-tooltip-when-elided="true" style="color: rgb(255, 255, 255);" />
                    </ui:GroupBox>
                    <ui:Label tabindex="-1" text="Please insert a description of a medical simulation to generate the visual storyboard" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResponseLabel" enable-rich-text="true" style="align-self: flex-start; white-space: normal; justify-content: flex-start; color: rgb(255, 255, 255);" />
                    <ui:VisualElement name="CodeElement" style="flex-grow: 1; flex-direction: row; justify-content: space-between; flex-shrink: 1; display: none;">
                        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CodeLabel" text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaa" style="background-color: rgb(40, 40, 40); flex-grow: 1; flex-shrink: 1; padding-right: 0; flex-direction: row; justify-content: space-between; white-space: normal;" />
                        <ui:VisualElement style="flex-grow: 0; background-color: rgb(40, 40, 40);">
                            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="CopyCodeButton" style="flex-shrink: 1; flex-grow: 1; background-color: rgb(40, 40, 40); background-image: url(&quot;project://database/Packages/com.oramavr.mages.core/JARIA/Editor/PanelImages/CopyButtonImage.png?fileID=21300000&amp;guid=77ee24aed3501de42b25a0eae83481e4&amp;type=3#CopyButtonImage&quot;); height: auto; margin-left: 0; padding-left: 10px; min-height: 26px; max-height: 26px; padding-bottom: 0; padding-top: 2px; margin-bottom: 3px; margin-top: 3px; align-self: flex-end; position: relative; right: auto; align-items: flex-start; justify-content: center; bottom: 0; min-width: 26px; max-width: 26px; -unity-background-scale-mode: scale-to-fit;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label tabindex="-1" text="Test" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResponseLabelContinue" enable-rich-text="true" style="align-self: flex-start; white-space: normal; flex-shrink: 1; flex-grow: 1; display: none;" />
                </ui:GroupBox>
                <ui:Label tabindex="-1" text="You need to be Signed in to use JARIA. Please sign in at the Sign In tab." parse-escape-sequences="true" display-tooltip-when-elided="true" name="ErrorLabel" style="background-color: rgb(166, 9, 9); color: rgb(255, 255, 255); margin-top: 30px; margin-right: 10px; margin-left: 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; white-space: normal;" />
            </ui:ScrollView>
            <ui:VisualElement name="UserInputBox" style="position: relative; flex-shrink: 1; flex-grow: 2; align-items: flex-end; -unity-background-scale-mode: stretch-to-fill; display: flex; justify-content: space-around; min-height: 60px; max-height: 120px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
                <ui:VisualElement name="testvis" style="flex-shrink: 1; overflow: visible; flex-grow: 0; align-self: stretch; align-items: stretch; justify-content: flex-start; flex-direction: row; background-image: url(&quot;project://database/Packages/com.oramavr.mages.core/JARIA/Editor/PanelImages/InputFieldShadowBackgroundImage.png?fileID=21300000&amp;guid=2f7052f223e0357429c33bddcb717fd2&amp;type=3#InputFieldShadowBackgroundImage&quot;);">
                    <ui:TextField picking-mode="Ignore" multiline="true" name="UserInputField" is-delayed="false" style="flex-shrink: 1; flex-grow: 1; white-space: normal; font-size: 12px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; color: rgb(255, 255, 255); display: flex; padding-top: 8px;" />
                </ui:VisualElement>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="SendButton" style="padding-right: 8px; padding-left: 8px; padding-bottom: 8px; margin-bottom: 0; margin-top: 0; padding-top: 8px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-color: rgba(36, 36, 36, 0.69); border-bottom-color: rgba(36, 36, 36, 0.69); flex-grow: 1; flex-shrink: 0; margin-right: 0; margin-left: 0; min-width: 50px; min-height: 50px;">
                    <ui:VisualElement style="background-image: url(&quot;project://database/Packages/com.oramavr.mages.core/JARIA/Editor/PanelImages/SendButtonImage.png?fileID=2800000&amp;guid=6de03b5807b05254da01ce85357a7eef&amp;type=3#SendButtonImage&quot;); display: flex; -unity-background-scale-mode: scale-to-fit; justify-content: center; align-items: center; flex-shrink: 0; flex-grow: 1; align-self: auto;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
