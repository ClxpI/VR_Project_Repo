<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="FoldoutElement" style="flex-grow: 1; flex-direction: column; justify-content: space-between; display: flex; border-right-color: rgba(200, 200, 200, 0); border-top-color: rgba(200, 200, 200, 0); border-bottom-color: rgba(200, 200, 200, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; text-overflow: ellipsis; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;">
        <ui:TextField picking-mode="Ignore" label="Label" value="Key" readonly="true" style="color: rgb(113, 113, 113);" />
