<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.oramavr.mages.core/Extra/Localization/Editor/MAGESLocalizationEditor.uss?fileID=7433441132597879392&amp;guid=f3460e422ac80904889a7eb0ff391fa2&amp;type=3#MAGESLocalizationEditor" />
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(39, 39, 39); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 20px; padding-right: 30px; padding-bottom: 20px; padding-left: 30px;">
        <ui:Foldout text="1. Languages" name="Languages" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 12px; -unity-font-style: normal;">
            <ui:ListView name="LanguagesListView" show-add-remove-footer="true" fixed-item-height="20" tooltip="A list containing all the available languages. Adding or removing languages from this list will update all the registered keys accordingly. For example, add a new element and type &apos;en&apos; for english." style="padding-bottom: 10px; font-size: 12px; min-height: 40px; background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 10px; padding-right: 10px; padding-left: 10px;" />
            <ui:TextField picking-mode="Ignore" label="Default Language" name="StartingLanguage" binding-path="currentLanguage" tooltip="The language to translate the registered keys to when starting the application" style="font-size: 12px; padding-top: 10px; background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-bottom: 10px; padding-right: 10px; padding-left: 10px; margin-top: 10px; color: rgb(255, 255, 255); -unity-font-style: normal;" />
        </ui:Foldout>
        <ui:Foldout text="2. Text Entries" name="TextEntries" value="false" style="padding-top: 20px; -unity-font-style: normal;">
            <ui:VisualElement style="flex-grow: 0; margin-left: auto; flex-direction: row; margin-right: 0; padding-right: 0; padding-left: 0; flex-shrink: 0; flex-wrap: nowrap; flex-basis: auto;">
                <ui:Button text="Import" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Import" style="margin-right: 4px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; min-height: 20px; margin-left: 4px; flex-grow: 0; flex-shrink: 0; padding-right: 12px; width: initial; max-width: none; min-width: 100px; -unity-text-align: middle-center; flex-direction: column;" />
                <ui:Button text="Export" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Export" style="margin-right: 4px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; min-height: 20px; margin-left: 4px; width: initial; max-width: none; min-width: 100px; flex-grow: 0; flex-direction: row;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="Open UI Prefab / Key Setup Tool" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TextEntriesWizard" tooltip="Opens a window displaying all the prefabs with a TextMeshPro component to easily set them up and add the translation keys" style="flex-grow: 1; flex-shrink: 1; max-height: 45px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; -unity-font-style: bold; max-width: 50%; width: 50%; height: auto; min-width: 50%;" />
                <ui:TextField picking-mode="Ignore" label="Search Key" name="SearchFieldText" multiline="false" style="padding-bottom: 10px; padding-right: 20px; flex-grow: 1; flex-shrink: 1; padding-top: 8px; -unity-text-outline-color: rgba(0, 0, 0, 0); background-color: rgb(89, 89, 89); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; -unity-slice-bottom: 0; -unity-background-scale-mode: scale-and-crop; margin-top: 2px; margin-right: 3px; padding-left: 10px; -unity-font-style: bold; color: rgb(255, 255, 255); width: auto; min-width: auto; overflow: hidden; text-overflow: clip; white-space: nowrap;" />
            </ui:VisualElement>
            <ui:ScrollView name="TextEntriesListView" horizontal-scroller-visibility="Hidden" nested-interaction-kind="ForwardScrolling" style="max-height: 480px;" />
            <ui:Label tabindex="-1" text="Add entries manually by pressing the &apos;Add new entry&apos; button or using the helper wizard by pressing the &apos;Open UI Prefab / Key Setup Tool&apos; button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="NoEntries" enable-rich-text="true" style="-unity-font-style: bold-and-italic; color: rgb(255, 0, 0); flex-wrap: wrap; white-space: normal; padding-top: 10px; padding-left: 4px;" />
            <ui:Button text="Add new entry" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AddTextEntry" tooltip="Adds a new empty entry to the text entries list" style="padding-right: 10px; padding-left: 10px; flex-grow: 1; flex-shrink: 1; margin-right: 0; margin-left: auto; background-color: rgb(211, 211, 211); color: rgb(0, 0, 0); margin-top: 10px; min-height: 30px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
        </ui:Foldout>
        <ui:Foldout text="3. Audio Entries" name="AudioEntries" value="false" style="padding-top: 20px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="Open UI Prefab / Key Setup Tool" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AudioEntriesWizard" tooltip="Opens a window displaying all the prefabs with an AudioClip component to easily set them up and add the translation keys" style="flex-shrink: 1; flex-grow: 1; max-height: 45px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; -unity-font-style: bold; width: 50%;" />
                <ui:TextField picking-mode="Ignore" label="Search Key" name="SearchFieldAudio" style="padding-right: 20px; padding-bottom: 10px; padding-top: 8px; flex-grow: 1; padding-left: 10px; background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; color: rgb(255, 255, 255); -unity-font-style: bold; width: 50%; max-width: 50%;" />
            </ui:VisualElement>
            <ui:ScrollView vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" name="AudioEntriesListView" nested-interaction-kind="ForwardScrolling" style="max-height: 480px;" />
            <ui:Label tabindex="-1" text="Add entries manually by pressing the &apos;Add new entry&apos; button or using the helper wizard by pressing the &apos;Open UI Prefab / Key Setup Tool&apos; button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="NoEntries" style="color: rgb(255, 0, 0); -unity-font-style: bold-and-italic; flex-wrap: wrap; white-space: normal; padding-top: 10px;" />
            <ui:Button text="Add new entry" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AddAudioEntry" tooltip="Adds a new empty entry to the audio entries list" style="margin-right: 0; margin-left: auto; padding-right: 10px; padding-left: 10px; background-color: rgb(211, 211, 211); color: rgb(0, 0, 0); margin-top: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; min-height: 30px;" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
