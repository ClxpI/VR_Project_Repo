<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Label tabindex="-1" text="Active Driver:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="active-driver" tooltip="The currently active driver." />
    <ui:DropdownField label="Driver Override" name="driver-override" tooltip="Override for the active driver.\n- If not null the device manager will try to use this driver instead of the one with the highest priority.\n- If this driver is not available will fall back to the driver with the highest priority. When this driver becomes available will immediately switch to it." />
    <ui:VisualElement name="drivers-lv">
        <ui:ListView name="drivers" reorderable="true" virtualization-method="DynamicHeight" reorder-mode="Animated" show-bound-collection-size="false" selection-type="None" show-foldout-header="true" header-title="Drivers" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="refresh-drivers" tooltip="Refresh the drivers lists to search and add new driver types." style="position: absolute; right: 0; top: 0; width: 18px; height: 18px; background-image: url(&quot;project://database/Packages/com.oramavr.mages.core/DeviceManager/Editor/v2/Icons/RefreshIcon.png?fileID=2800000&amp;guid=36199a672125a3d4184ebfc8cd55a6db&amp;type=3#RefreshIcon&quot;); max-width: 18px; min-width: 18px; max-height: 18px; min-height: 18px; -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2;" />
    </ui:VisualElement>
</ui:UXML>
