<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="VisualElement">
        <ui:EnumField label="XR Mode" type="MAGES.DeviceManagerModule+CameraMode, MAGES.Hub.Runtime" name="XR_Mode" include-obsolete-values="false" binding-path="currentMode" value="Mobile3D" focusable="true" style="width: 400px;" />
        <ui:FloatField label="Camera Height" value="1.5" binding-path="camHeight" name="CamHeight" focusable="true" style="width: 400px;" />
        <uie:PropertyField name="OverrideMobileNavigationUI" binding-path="mobileNavigationUI" tooltip="Override the mobile navigation UI with the prefab inserted here.  If null, it uses the default MobileNavigation UI from MAGES." label="Override Mobile NavigationUI" />
        <uie:PropertyField name="XRLoaderOffsets" />
        <uie:PropertyField name="InputController" binding-path="InputController" />
        <ui:Button text="Install XR Plugin" display-tooltip-when-elided="true" name="XRPlugin" style="justify-content: flex-start; align-self: center; height: auto; width: auto; align-items: auto; position: relative; left: auto; top: auto; min-width: 150px; max-width: 150px; display: flex; visibility: visible; white-space: nowrap; -unity-text-align: middle-center; text-overflow: clip; right: auto;" />
    </ui:VisualElement>
</ui:UXML>
