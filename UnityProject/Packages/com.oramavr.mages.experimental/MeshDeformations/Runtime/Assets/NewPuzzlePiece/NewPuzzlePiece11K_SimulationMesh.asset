  - ParticleDamping: 0.01
    DistanceConstraintInverseStiffness: 0
    DistanceConstraintTearForce: 0
    VolumeConstraintInverseStiffness: 0
    CollinearConstraintInverseStiffness: 0
    ShapeMatchingConstraintStiffness: 1
