<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="title-area" style="flex-direction: row;">
        <ui:VisualElement style="background-image: url(&apos;project://database/Packages/com.oramavr.mages.experimental/MeshDeformations/Editor/Icons/cloth-actor@2x.png?fileID=2800000&amp;guid=7baf3f9461210e44d96c49168d69eb09&amp;type=3#cloth-actor@2x&apos;); -unity-background-scale-mode: scale-to-fit; width: 32px; height: 32px;" />
        <ui:Label text="Cloth Actor" name="title" style="-unity-font-style: bold; font-size: 16px; -unity-text-align: middle-left; flex-grow: 1; margin-left: 5px;" />
    </ui:VisualElement>
    <ui:VisualElement name="tool-area" style="align-items: center; justify-content: center; flex-direction: row;">
        <ui:Label text="Edit Particles" />
        <ui:Button name="edit-particles" icon-image="project://database/Assets/Scripts/Editor/Icons/edit-particles.png?fileID=2800000&amp;guid=693cad15043784f42842b45b3d129af2&amp;type=3#edit-particles" style="width: 30px; height: 30px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:VisualElement name="icon" style="flex-grow: 1; background-image: url(&apos;project://database/Packages/com.oramavr.mages.experimental/MeshDeformations/Editor/Icons/edit-particles@2x.png?fileID=2800000&amp;guid=3e933f82303ad2644927decb1efc0f24&amp;type=3#edit-particles@2x&apos;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:Label text="Simulation Settings" style="margin-top: 10px; -unity-font-style: bold; font-size: 14px;" />
    <uie:ObjectField label="Physics World" name="physics-world" tooltip="The physics world in which this actor will be added." />
    <uie:ObjectField label="Mesh" name="source-mesh" />
    <ui:FloatField label="Mass" name="mass" is-delayed="true" tooltip="The total object mass. Range in [ 1e-07f, 1e+09f ]." />
    <ui:FloatField label="Damping" name="damping" is-delayed="true" tooltip="Particle Damping. [ 0, 1 ]." />
    <ui:Toggle label="Self Collision" name="self-collision" />
    <ui:UnsignedIntegerField label="Layer" name="layer" tooltip="The collision layer." max-length="3" />
    <ui:Toggle label="Update Kinematic Particles" name="update-kinematic-particles" tooltip="Update the kinematic particles position when object is moved with the Transform tool?" />
</ui:UXML>
