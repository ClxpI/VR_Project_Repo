<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement style="flex-direction: row;">
        <ui:VisualElement style="background-image: url(&quot;project://database/Packages/com.oramavr.mages.experimental/MeshDeformations/Editor/Icons/rigidbody-actor@2x.png?fileID=2800000&amp;guid=4422828bd7378e44a8653a0103ecdf4d&amp;type=3#rigidbody-actor@2x&quot;); -unity-background-scale-mode: scale-to-fit; width: 32px; height: 32px;" />
        <ui:Label text="Rigidbody Actor" name="title" style="-unity-font-style: bold; font-size: 16px; -unity-text-align: middle-left; flex-grow: 1; margin-left: 5px;" />
    </ui:VisualElement>
    <ui:VisualElement name="tool-area" style="align-items: center; justify-content: center; flex-direction: row;">
        <ui:Label text="Edit Particles" />
        <ui:Button name="edit-particles" icon-image="project://database/Assets/Scripts/Editor/Icons/edit-particles.png?fileID=2800000&amp;guid=693cad15043784f42842b45b3d129af2&amp;type=3#edit-particles" style="width: 30px; height: 30px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:VisualElement name="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.oramavr.mages.experimental/MeshDeformations/Editor/Icons/edit-particles@2x.png?fileID=2800000&amp;guid=3e933f82303ad2644927decb1efc0f24&amp;type=3#edit-particles@2x&quot;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:Label text="Simulation Settings" style="margin-top: 10px; -unity-font-style: bold; font-size: 14px;" />
    <uie:ObjectField label="Physics World" name="physics-world" tooltip="The physics world in which this actor will be added." />
    <uie:ObjectField label="Simulation Mesh" name="simulation-mesh" tooltip="The simulation mesh for this actor." />
    <ui:Toggle label="Can Cut" name="can-cut" tooltip=" Can this object be used for cutting other obejcts?" />
    <ui:UnsignedIntegerField label="Layer" name="layer" tooltip="The collision layer." max-length="3" />
    <ui:Toggle label="Is Kinematic" name="is-kinematic" />
    <ui:Toggle label="Update Kinematic Particles" name="update-kinematic-particles" />
</ui:UXML>
